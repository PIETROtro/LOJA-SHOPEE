@model ShopeeMVC.Models.Produto
@{ ViewData["Title"] = "Novo Produto"; }
<h1>Novo Produto</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control"/><span asp-validation-for="Nome" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Preco" class="form-label"></label><input asp-for="Preco" class="form-control" step="0.01"/><span asp-validation-for="Preco" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Estoque" class="form-label"></label><input asp-for="Estoque" class="form-control"/><span asp-validation-for="Estoque" class="text-danger"></span></div>
    <button class="btn btn-success">Salvar</button> <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>