@model ShopeeMVC.Models.Produto
@{ ViewData["Title"] = "Editar Produto"; }
<h1>Editar Produto</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Codigo"/>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control"/></div>
    <div class="mb-3"><label asp-for="Preco" class="form-label"></label><input asp-for="Preco" class="form-control" step="0.01"/></div>
    <div class="mb-3"><label asp-for="Estoque" class="form-label"></label><input asp-for="Estoque" class="form-control"/></div>
    <button class="btn btn-primary">Salvar alterações</button> <a asp-action="Index" class="btn btn-secondary">Voltar</a>
</form>