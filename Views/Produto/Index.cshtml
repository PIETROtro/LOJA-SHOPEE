@model IEnumerable<ShopeeMVC.Models.Produto>
@{
    ViewData["Title"] = "Produtos";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>🛍️ Produtos</h1>
    <div>
        <a asp-controller="Carrinho" asp-action="Index" class="btn btn-dark">🛒 Carrinho</a>
        <a asp-action="Create" class="btn btn-success">+ Novo produto</a>
    </div>
</div>
<div class="row g-4">
@foreach (var item in Model)
{
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h4 class="card-title">@item.Nome</h4>
                <p class="text-muted">Estoque: @item.Estoque</p>
                <h3>@item.Preco.ToString("C")</h3>
                <div class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Carrinho" asp-action="Adicionar" asp-route-id="@item.Codigo" class="btn btn-primary">Adicionar ao carrinho</a>
                    <a asp-action="Edit" asp-route-id="@item.Codigo" class="btn btn-outline-secondary">Editar</a>
                    <a asp-action="Delete" asp-route-id="@item.Codigo" class="btn btn-outline-danger">Excluir</a>
                </div>
            </div>
        </div>
    </div>
}
</div>